modules = ["python-3.11"]
run = "python3 main.py"
entrypoint = "main.py"

[nix]
channel = "stable-23_11"
packages = ["psmisc"]

[[ports]]
localPort = 8080
externalPort = 80

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd ground-hazard-tracker && python3 main.py"
waitForPort = 8080

[workflows.workflow.metadata]
outputType = "webview"
